TASK_STORAGE=mysql
DB_HOST=your-test-mysql-host
DB_PORT=3306
DB_USER=codeflow_app
DB_PASSWORD=replace-locally
DB_NAME=codeflow_test
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_MS=10000
DB_TLS=true
# DB_TLS_CA_FILE=C:/secure/mysql-ca.pem
SELF_TEST_BATCH_SIZE=8
SELF_TEST_MAX_CASES=300
# Optional global model deadlines in milliseconds (10000..3600000).
# Unset: short reviews use 600000 first response / 300000 inactivity;
# coding and test generation retain 1200000 for both windows.
# MODEL_FIRST_RESPONSE_TIMEOUT_MS=600000
# MODEL_INACTIVITY_TIMEOUT_MS=300000