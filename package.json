{
  "name": "copilot-workbench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && node scripts/copy-playwright-reporter.mjs && vite build",
    "start": "node dist-server/server/index.js",
    "test": "node --import tsx --test --test-concurrency=1 \"server/**/*.test.ts\"",
    "test:mysql-v2": "node --import tsx --test server/storage/mysql-v2.integration.test.ts",
    "db:check": "tsx server/storage/db-check.ts",
    "db:smoke": "tsx server/storage/db-smoke.ts",
    "db:maintenance": "tsx server/storage/storage-maintenance.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.14",
    "css-tree": "^3.2.1",
    "docx": "^9.15.0",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.0",
    "mysql2": "^3.15.3",
    "parse5": "^8.0.1",
    "playwright-core": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/css-tree": "^3.2.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
